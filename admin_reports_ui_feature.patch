+    document.querySelectorAll(".erp-report").forEach(function (table) {
+      if (table.closest(".erp-report-scroll")) return;
+      var wrapper = document.createElement("div");
+      wrapper.className = "erp-report-scroll";
+      table.parentNode.insertBefore(wrapper, table);
+      wrapper.appendChild(table);
