+            {% endif %}
+          {% endfor %}
+        {% endfor %}
+      </div>
+    {% endif %}
+
+    {# Management form MUST be inside <form> #}
+    {{ inline_admin_formsets.0.formset.management_form }}
+
+    <!-- Hidden row template (kept in <script type="text/html"> so the browser keeps the <tr>).
+         Must stay structurally identical to the rows rendered below. -->
+    <script type="text/html" id="line-empty-form-template">
+      <tr class="item-form-row voucher-line-row">
+        <td class="row-num-cell">
+          <span class="row-num">#</span>
