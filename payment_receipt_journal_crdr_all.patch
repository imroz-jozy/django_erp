+          <span class="mobile-sticky-total-label">TOTAL</span>
+          <span class="val v-sum-total">₹ 0.00</span>
+        </div>
+        <button type="submit" name="_save" class="btn-action btn-action-primary">💾 Save</button>
+      </div>
+
+    </div>
+  </form>
+</div>
+{% endblock %}
