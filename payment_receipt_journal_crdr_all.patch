+          <h1 class="voucher-title">{% if add %}{% if opts.model_name == 'payment' %}New Payment{% elif opts.model_name == 'receipt' %}New Receipt{% elif opts.model_name == 'creditnote' %}New Credit Note{% else %}New Debit Note{% endif %}{% else %}Voucher: {{ original }}{% endif %}</h1>
