+                    <td data-label="{% if opts.model_name == 'payment' or opts.model_name == 'creditnote' %}Account (Dr){% else %}Account (Cr){% endif %}">{{ inline_admin_form.form.account }}</td>
+                    <td data-label="Amount (₹)">{{ inline_admin_form.form.amount }}</td>
+                    <td class="row-del-cell">
+                      {% if inline_admin_form.has_delete_permission and inline_admin_form.original %}
