+                      <button type="button" class="btn-remove-row btn-delete-line-row" title="Remove (Ctrl+Del)">&times;</button>
+                    </td>
+                  </tr>
+                {% endif %}
+              {% endfor %}
+            </tbody>
+          </table>
+        </div>
+
+        <!-- TOTALS -->
+        <div class="voucher-bottom-dock cash-dock">
