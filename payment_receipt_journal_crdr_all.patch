+            <thead>
+              <tr>
+                <th style="width:40px; text-align:center;">#</th>
+                <th style="min-width:260px;">{% if opts.model_name == 'payment' %}Account (Party / Expense) &mdash; Dr{% elif opts.model_name == 'receipt' %}Account (Party / Income) &mdash; Cr{% elif opts.model_name == 'creditnote' %}Reason Ledger (Sales Return, Discount Allowed...) &mdash; Dr{% else %}Reason Ledger (Purchase Return, Discount Received...) &mdash; Cr{% endif %}</th>
+                <th style="width:160px; text-align:right;">Amount (₹)</th>
+                <th style="width:50px; text-align:center;">Del</th>
+              </tr>
+            </thead>
+            <tbody id="voucher-lines-tbody">
+              {% for inline_admin_form in inline_admin_formsets.0 %}
+                {% if inline_admin_form.original or not forloop.last %}
+                  <tr class="item-form-row voucher-line-row">
+                    <td class="row-num-cell">
+                      <span class="row-num">{{ forloop.counter }}</span>
+                      {% for field in inline_admin_form.form.hidden_fields %}{{ field }}{% endfor %}
