+{% load i18n admin_urls static admin_modify %}
+
+{# Shared by Payment, Receipt, Credit Note and Debit Note. Same look/behaviour as the Sale Voucher screen. #}
+
+{% block extrahead %}
+{{ block.super }}
+{{ media }}
+{% endblock %}
+
+{% block breadcrumbs %}
