+          <button type="submit" name="_addanother" class="btn-action btn-action-secondary">➕ Save &amp; Add Another</button>
+          <button type="submit" name="_continue" class="btn-action btn-action-secondary">✏️ Save &amp; Continue</button>
+          <a href="{% url opts|admin_urlname:'changelist' %}" class="btn-action btn-action-danger" style="text-decoration:none;">❌ Cancel</a>
+        </div>
