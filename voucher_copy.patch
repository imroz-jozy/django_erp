+{% extends "admin/base_site.html" %}
+{% load i18n admin_urls static admin_modify %}
+
+{% block extrahead %}
+{{ block.super }}
+{{ media }}
+{% endblock %}
+
+{% block breadcrumbs %}
+<div class="breadcrumbs">
+<a href="{% url 'admin:index' %}">{% translate 'Home' %}</a>
+&rsaquo; <a href="{% url 'admin:app_list' app_label=opts.app_label %}">{{ opts.app_config.verbose_name }}</a>
+&rsaquo; <a href="{% url 'admin:masters_purchase_changelist' %}">Purchases</a>
+&rsaquo; {% if add %}{% translate 'Add Purchase Voucher' %}{% else %}{{ original }}{% endif %}
+</div>
+{% endblock %}
+
+{% block content %}
+<div id="content-main">
+  <form {% if has_file_field %}enctype="multipart/form-data" {% endif %}action="{{ form_url }}" method="post" id="sale_form" novalidate>
+    {% csrf_token %}
+
+    {% if is_popup %}<input type="hidden" name="{{ is_popup_var }}" value="1">{% endif %}
+    {% if to_field %}<input type="hidden" name="{{ to_field_var }}" value="{{ to_field }}">{% endif %}
+
+    {% if errors %}
+      <div style="background:#fee2e2; border:1px solid #f87171; color:#991b1b; border-radius:6px; padding:12px; margin-bottom:12px;">
+        <strong>{% translate 'Please correct the errors below:' %}</strong>
+        {{ adminform.form.non_field_errors }}
+        {% for inline in inline_admin_formsets %}
+          {{ inline.formset.non_form_errors }}
+          {% for iform in inline.formset.forms %}
+            {% if iform.errors %}
+              <div style="margin-top:4px;">{{ inline.opts.verbose_name }} line {{ forloop.counter }}: {{ iform.errors }}</div>
+            {% endif %}
+          {% endfor %}
+        {% endfor %}
+      </div>
+    {% endif %}
+
+    {# Management forms for inline formsets — MUST be inside <form> #}
+    {{ inline_admin_formsets.0.formset.management_form }}
+    {{ inline_admin_formsets.1.formset.management_form }}
+
+    <!-- HIDDEN ROW TEMPLATES stored in <script type="text/html"> so browser does NOT strip <tr> tags.
+         These MUST stay structurally identical to the rows rendered below, including data-label
+         attributes and row-num-cell/row-del-cell classes, so a row added by JS looks and behaves
+         exactly the same in both desktop-grid and mobile-card layouts. -->
+    <script type="text/html" id="item-empty-form-template">
+      <tr class="item-form-row">
+        <td class="row-num-cell">
+          <span class="row-num">#</span>
+          {% for field in inline_admin_formsets.0.formset.empty_form.hidden_fields %}{{ field }}{% endfor %}
+        </td>
+        <td data-label="Item"><div class="v-input-item-wrap">{{ inline_admin_formsets.0.formset.empty_form.item }}</div></td>
+        <td data-label="Unit">{{ inline_admin_formsets.0.formset.empty_form.unit }}</td>
+        <td data-label="Qty (Billed+Free)">{{ inline_admin_formsets.0.formset.empty_form.quantity }}</td>
+        <td data-label="Rate (₹)">{{ inline_admin_formsets.0.formset.empty_form.rate }}</td>
+        <td data-label="Discount (₹)">{{ inline_admin_formsets.0.formset.empty_form.discount }}</td>
+        <td data-label="Tax %">{{ inline_admin_formsets.0.formset.empty_form.tax }}</td>
+        <td class="num-cell-readonly" data-label="Basic Amount"><span class="v-out-basic">0.00</span></td>
+        <td class="num-cell-readonly" data-label="Tax Amount"><span class="v-out-tax">0.00</span></td>
+        <td class="num-cell-readonly" data-label="Net Amount" style="font-weight:700; color:#059669;"><span class="v-out-net">0.00</span></td>
+        <td class="row-del-cell">
+          <button type="button" class="btn-remove-row btn-delete-item-row" title="Remove">&times;</button>
+        </td>
+      </tr>
+    </script>
+
+    <script type="text/html" id="sundry-empty-form-template">
+      <tr class="sundry-form-row">
+        <td data-label="Bill Sundry">
+          {% for field in inline_admin_formsets.1.formset.empty_form.hidden_fields %}{{ field }}{% endfor %}
+          {{ inline_admin_formsets.1.formset.empty_form.bill_sundry }}
+          <span class="sundry-multirate-hint" style="display:none;">⚡ Before GST (Multirate)</span>
+        </td>
+        <td data-label="Amount (₹)">{{ inline_admin_formsets.1.formset.empty_form.amount }}</td>
+        <td class="row-del-cell">
+          <button type="button" class="btn-remove-row btn-delete-sundry-row">&times;</button>
+        </td>
+      </tr>
+    </script>
+
+    <!-- PURCHASE VOUCHER MASTER WRAPPER (copy of Sale Voucher front end) -->
+    <div class="sale-voucher-wrapper auto-responsive" data-price-field="purchase_price">
+
+      <!-- TOP APP BAR -->
+      <div class="voucher-top-bar">
+        <div class="voucher-title-group">
+          <span class="voucher-badge">PURCHASE VOUCHER</span>
+          <h1 class="voucher-title">{% if add %}New Purchase Invoice{% else %}Invoice: {{ adminform.form.invoice_no.value|default:original }}{% endif %}</h1>
+        </div>
+
+        <div class="view-mode-toggle">
+          <button type="button" class="view-mode-btn active" id="btn-mode-auto" onclick="setVoucherMode('auto')">
+            ⚡ Auto
+          </button>
+          <button type="button" class="view-mode-btn" id="btn-mode-desktop" onclick="setVoucherMode('desktop')">
+            💻 Desktop
+          </button>
+          <button type="button" class="view-mode-btn" id="btn-mode-mobile" onclick="setVoucherMode('mobile')">
+            📱 Mobile
+          </button>
+        </div>
+
+        <div class="shortcuts-legend">
+          <span><kbd>F2</kbd> Save</span>
+          <span><kbd>Enter</kbd> Next Cell</span>
+        </div>
+      </div>
+
+      <!-- MASTER HEADER FIELDS CARD -->
+      <div class="voucher-header-card">
+        <div class="voucher-header-grid voucher-header-grid-6">
+          <div class="v-field-group">
+            <label for="id_date">Voucher Date *</label>
+            {{ adminform.form.date }}
+            {% if adminform.form.date.errors %}<div class="field-error">{{ adminform.form.date.errors }}</div>{% endif %}
+          </div>
+          <div class="v-field-group">
+            <label for="id_invoice_no">Invoice No *</label>
+            {{ adminform.form.invoice_no }}
+            {% if adminform.form.invoice_no.errors %}<div class="field-error">{{ adminform.form.invoice_no.errors }}</div>{% endif %}
+          </div>
+          <div class="v-field-group">
+            <label for="id_purchase_type">Purchase Type *</label>
+            {{ adminform.form.purchase_type }}
+            {% if adminform.form.purchase_type.errors %}<div class="field-error">{{ adminform.form.purchase_type.errors }}</div>{% endif %}
+          </div>
+          <div class="v-field-group">
+            <label for="id_account">Party / Supplier *</label>
+            {{ adminform.form.account }}
+            {% if adminform.form.account.errors %}<div class="field-error">{{ adminform.form.account.errors }}</div>{% endif %}
+          </div>
+          <div class="v-field-group">
+            <label for="id_is_reverse_charge">Reverse Charge (RCM)</label>
+            {{ adminform.form.is_reverse_charge }}
+            {% if adminform.form.is_reverse_charge.errors %}<div class="field-error">{{ adminform.form.is_reverse_charge.errors }}</div>{% endif %}
+          </div>
+          <div class="v-field-group v-field-narration">
+            <label for="id_narration">Narration</label>
+            {{ adminform.form.narration }}
+          </div>
+        </div>
+      </div>
+
+      <!-- ========================================================= -->
+      <!-- ONE table drives BOTH desktop grid and mobile card views. -->
+      <!-- JS toggles a single `is-mobile-layout` class on the       -->
+      <!-- wrapper; CSS reflows these same <td> fields into cards -   -->
+      <!-- there is no separate/duplicated mobile markup or inputs,  -->
+      <!-- so nothing can drift out of sync or break form submission -->
+      <!-- ========================================================= -->
+      <div class="voucher-body-container">
+
+        <!-- ADD ITEM TOOLBAR -->
+        <div class="items-toolbar">
+          <button type="button" class="btn-add-row" id="btn-add-item-row">
+            ➕ Add Item Line &nbsp;<kbd>Enter</kbd>
+          </button>
+          <span class="items-toolbar-tip">💡 Tip: Use '10+2' in Qty for scheme (10 Billed + 2 Free)</span>
+        </div>
+
+        <!-- ITEM TABLE / CARD GRID -->
+        <div class="busy-table-wrapper">
+          <table class="busy-table">
+            <thead>
+              <tr>
+                <th style="width:40px; text-align:center;">#</th>
+                <th style="min-width:220px;">Item Description</th>
+                <th style="width:100px;">Unit</th>
+                <th style="width:110px; text-align:right;">Qty (Billed+Free)</th>
+                <th style="width:110px; text-align:right;">Rate (₹)</th>
+                <th style="width:100px; text-align:right;">Disc (₹)</th>
+                <th style="width:90px; text-align:right;">Tax %</th>
+                <th style="width:120px; text-align:right;">Basic Amt (₹)</th>
+                <th style="width:110px; text-align:right;">Tax Amt (₹)</th>
+                <th style="width:130px; text-align:right;">Net Amt (₹)</th>
+                <th style="width:50px; text-align:center;">Del</th>
+              </tr>
+            </thead>
+            <tbody id="busy-items-tbody">
+              {% for inline_admin_form in inline_admin_formsets.0 %}
+                {# Skip the empty form rendered last by InlineAdminFormSet.__iter__ #}
+                {% if inline_admin_form.original or not forloop.last %}
+                  <tr class="item-form-row">
+                    <td class="row-num-cell">
+                      <span class="row-num">{{ forloop.counter }}</span>
+                      {% for field in inline_admin_form.form.hidden_fields %}{{ field }}{% endfor %}
+                    </td>
+                    <td data-label="Item">
+                      <div class="v-input-item-wrap">{{ inline_admin_form.form.item }}</div>
+                    </td>
+                    <td data-label="Unit">{{ inline_admin_form.form.unit }}</td>
+                    <td data-label="Qty (Billed+Free)">{{ inline_admin_form.form.quantity }}</td>
+                    <td data-label="Rate (₹)">{{ inline_admin_form.form.rate }}</td>
+                    <td data-label="Discount (₹)">{{ inline_admin_form.form.discount }}</td>
+                    <td data-label="Tax %">{{ inline_admin_form.form.tax }}</td>
+                    <td class="num-cell-readonly" data-label="Basic Amount"><span class="v-out-basic">0.00</span></td>
