+              <span class="val v-sum-grand-net">₹ 0.00</span>
+            </div>
+          </div>
+
+        </div>
+
+        <!-- ACTION TOOLBAR -->
+        <div class="voucher-action-bar">
+          <button type="submit" name="_save" class="btn-action btn-action-primary">
+            💾 Save Voucher (F2)
+          </button>
+          <button type="submit" name="_addanother" class="btn-action btn-action-secondary">
