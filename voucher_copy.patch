+                      <button type="button" class="btn-remove-row btn-delete-item-row" title="Remove">&times;</button>
+                    </td>
+                  </tr>
+                {% endif %}
+              {% endfor %}
+            </tbody>
+          </table>
+        </div>
+
+        <!-- BILL SUNDRIES + TOTALS -->
+        <div class="voucher-bottom-dock">
+
+          <!-- BILL SUNDRIES PANEL -->
+          <div class="sundries-panel">
