+              </button>
+            </div>
+            <div class="sundries-table-scroll">
+              <table class="sundries-table">
+                <thead>
+                  <tr>
+                    <th style="width:60%;">Bill Sundry</th>
+                    <th style="width:30%; text-align:right;">Amount (₹)</th>
+                    <th style="width:10%;"></th>
+                  </tr>
+                </thead>
+                <tbody id="busy-sundries-tbody">
+                  {% for inline_admin_form in inline_admin_formsets.1 %}
+                    {% if inline_admin_form.original or not forloop.last %}
+                      <tr class="sundry-form-row">
