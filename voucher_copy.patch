+          </div>
+          <div class="v-field-group">
+            <label for="id_voucher_no">Voucher No *</label>
+            {{ adminform.form.voucher_no }}
+            {% if adminform.form.voucher_no.errors %}<div class="field-error">{{ adminform.form.voucher_no.errors }}</div>{% endif %}
+          </div>
+          <div class="v-field-group">
+            <label for="id_sale_type">Sale Type *</label>
+            {{ adminform.form.sale_type }}
+            {% if adminform.form.sale_type.errors %}<div class="field-error">{{ adminform.form.sale_type.errors }}</div>{% endif %}
+          </div>
+          <div class="v-field-group">
+            <label for="id_account">Party / Customer *</label>
+            {{ adminform.form.account }}
+            {% if adminform.form.account.errors %}<div class="field-error">{{ adminform.form.account.errors }}</div>{% endif %}
+          </div>
+          <div class="v-field-group">
+            <label for="id_against_sale">Against Sale Invoice</label>
+            {{ adminform.form.against_sale }}
