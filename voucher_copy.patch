+                      </tr>
+                    {% endif %}
+                  {% endfor %}
+                </tbody>
+              </table>
+            </div>
+          </div>
+
+          <!-- VOUCHER TOTALS SUMMARY BOX -->
+          <div class="totals-summary-card">
+            <div class="totals-summary-header">VOUCHER SUMMARY</div>
+            <div class="totals-row">
+              <label>Basic Subtotal</label>
+              <span class="val" id="v-sum-basic">₹ 0.00</span>
+            </div>
+            <div class="totals-row">
+              <label>Discount Total</label>
+              <span class="val" id="v-sum-disc">₹ 0.00</span>
+            </div>
+            <div class="totals-row">
+              <label>Tax Total</label>
+              <span class="val" id="v-sum-tax">₹ 0.00</span>
+            </div>
+            <div class="totals-row">
+              <label>Bill Sundries</label>
