 }
 
-/* Force container height to single page layout on desktop-sized screens */
+/* Desktop styling: no forced viewport-height clamp here (that was clipping the
+   summary card on shorter screens). The page lays out and scrolls normally
+   like any other admin form; only the item grid itself gets a fixed height
+   with its own internal scrollbar (see .busy-table-wrapper below), so item
+   rows are always the thing that scrolls, not the whole voucher. */
 @media (min-width: 769px) {
-  #content-main {
-    padding-bottom: 0 !important;
-  }
   .sale-voucher-wrapper {
     display: flex;
     flex-direction: column;
-    height: calc(100vh - 85px);
-    max-height: calc(100vh - 85px);
-    overflow: hidden;
     background-color: var(--busy-bg);
     border-radius: 8px;
     box-shadow: var(--busy-shadow);
@@ -198,19 +196,16 @@
 .voucher-body-container {
   display: flex;
   flex-direction: column;
-  flex: 1;
-  min-height: 0; /* Crucial for internal scrollbars on desktop */
-  overflow: hidden;
   background: var(--busy-card-bg);
 }
 
 .busy-table-wrapper {
-  flex: 1;
-  min-height: 340px; /* guarantees roughly 9-10 item rows are visible before scrolling */
-  overflow: auto; /* Both horizontal and vertical scrollbars on desktop */
+  height: 380px; /* fixed height so roughly 9-10 item rows are always visible; this is the ONLY part that scrolls internally */
+  overflow: auto; /* Both horizontal and vertical scrollbars */
   position: relative;
   background: #ffffff;
   border-bottom: 1px solid var(--busy-border);
+  flex-shrink: 0;
 }
 
 .busy-table-wrapper::-webkit-scrollbar {
@@ -601,6 +596,7 @@
 }
 
 .sale-voucher-wrapper.is-mobile-layout .busy-table-wrapper {
+  height: auto;
   overflow: visible;
   flex: none;
   border-bottom: none;
